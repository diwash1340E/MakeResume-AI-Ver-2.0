# Keep this file private. Copy to .env.local, never commit your keys.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Configure these only if using the corresponding provider.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Requires a running local Ollama installation and downloaded model.
OLLAMA_MODEL=qwen2.5:7b
PORT=3000
HOST=127.0.0.1
